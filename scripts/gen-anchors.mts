/**
 * Writes lib/scene/anchors.ts: light copies of the talent path and one output arc
 * (arc 1, which is fully lit while the hero is at rest),
 * so the page can place the hero labels over the static poster without building the terrain.
 *   node scripts/gen-anchors.mts
 */
import { writeFileSync } from "node:fs"
import { buildGeometry } from "../lib/scene/geometry.ts"
import { along } from "../lib/scene/terrain.mjs"

const g = buildGeometry("high")
const round = (a: Float32Array) => Array.from(a, (v) => Math.round(v * 100) / 100)
const climb = round(along(g.climb, 64))
const arc = round(along(g.arcs.subarray(1 * 192, 2 * 192), 32))
const route = round(along(g.route, 32))
writeFileSync(
  new URL("../lib/scene/anchors.ts", import.meta.url),
  `/* Generated by scripts/gen-anchors.mts from lib/scene/geometry.ts. Do not edit by hand. */
export const CLIMB = new Float32Array(${JSON.stringify(climb)})
export const ARC = new Float32Array(${JSON.stringify(arc)})
export const ROUTE = new Float32Array(${JSON.stringify(route)})
export const SUMMIT: [number, number, number] = ${JSON.stringify(g.summit.map((v) => Math.round(v * 100) / 100))}
`,
)
console.log("anchors written", climb.length / 3, arc.length / 3)
